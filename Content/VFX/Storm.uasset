void StoreUpdateVariables(in FSimulationContext Context, bool bIsValidInstance)
{
#if ((SimulationStageIndex == 0)) // MapUpdate
		const bool bValid = bIsValidInstance;
		const int WriteIndex = OutputIndex(0, false, bValid);
		if (bValid)
		{
			OutputDataFloat(0, 0, WriteIndex, Context.MapUpdate.Particles.Color.r);
			OutputDataFloat(0, 1, WriteIndex, Context.MapUpdate.Particles.Color.g);
			OutputDataFloat(0, 2, WriteIndex, Context.MapUpdate.Particles.Color.b);
			OutputDataFloat(0, 3, WriteIndex, Context.MapUpdate.Particles.Color.a);
			OutputDataFloat(0, 4, WriteIndex, Context.MapUpdate.Particles.Mass);
			OutputDataFloat(0, 5, WriteIndex, Context.MapUpdate.Particles.MaterialRandom);
			OutputDataFloat(0, 6, WriteIndex, Context.MapUpdate.Particles.Position.x);
			OutputDataFloat(0, 7, WriteIndex, Context.MapUpdate.Particles.Position.y);
			OutputDataFloat(0, 8, WriteIndex, Context.MapUpdate.Particles.Position.z);
			OutputDataFloat(0, 9, WriteIndex, Context.MapUpdate.Particles.Previous.Position.x);
			OutputDataFloat(0, 10, WriteIndex, Context.MapUpdate.Particles.Previous.Position.y);
			OutputDataFloat(0, 11, WriteIndex, Context.MapUpdate.Particles.Previous.Position.z);
			OutputDataFloat(0, 12, WriteIndex, Context.MapUpdate.Particles.Previous.SpriteSize.x);
			OutputDataFloat(0, 13, WriteIndex, Context.MapUpdate.Particles.Previous.SpriteSize.y);
			OutputDataFloat(0, 14, WriteIndex, Context.MapUpdate.Particles.Previous.Velocity.x);
			OutputDataFloat(0, 15, WriteIndex, Context.MapUpdate.Particles.Previous.Velocity.y);
			OutputDataFloat(0, 16, WriteIndex, Context.MapUpdate.Particles.Previous.Velocity.z);
			OutputDataFloat(0, 17, WriteIndex, Context.MapUpdate.Particles.RibbonUVDistance);
			OutputDataFloat(0, 18, WriteIndex, Context.MapUpdate.Particles.SpriteSize.x);
			OutputDataFloat(0, 19, WriteIndex, Context.MapUpdate.Particles.SpriteSize.y);
			OutputDataInt(0, 0, WriteIndex, Context.MapUpdate.Particles.UniqueID);
			OutputDataFloat(0, 20, WriteIndex, Context.MapUpdate.Particles.Velocity.x);
			OutputDataFloat(0, 21, WriteIndex, Context.MapUpdate.Particles.Velocity.y);
			OutputDataFloat(0, 22, WriteIndex, Context.MapUpdate.Particles.Velocity.z);
		}
		// If a stage doesn't kill particles, StoreUpdateVariables() never calls AcquireIndex(), so the
		// count isn't updated. In that case we must manually copy the original count here.
		if (WriteInstanceCountOffset != 0xFFFFFFFF && GLinearThreadId == 0) 
		{
			RWInstanceCounts[WriteInstanceCountOffset] = GSpawnStartInstance + NumSpawnedInstances; 
		}
#endif // MapUpdate

}

